rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function konekte() {
      return request.auth != null;
    }

    function manmBiznis(bizId) {
      return konekte()
        && exists(
          /databases/$(database)/documents/biznis/$(bizId)/itilizate/$(request.auth.uid)
        );
    }

    function wolItilizate(bizId) {
      return get(
        /databases/$(database)/documents/biznis/$(bizId)/itilizate/$(request.auth.uid)
      ).data.wol;
    }

    function genWol(bizId, wolOtorize) {
      return manmBiznis(bizId)
        && wolItilizate(bizId) in wolOtorize;
    }

    function seAdministrate(bizId) {
      return genWol(bizId, ['Propriyete', 'Administrate']);
    }

    function seKontablOswaAdmin(bizId) {
      return genWol(bizId, ['Propriyete', 'Administrate', 'Kontable', 'Direkte']);
    }

    function seVandeOswaAdmin(bizId) {
      return genWol(bizId, ['Propriyete', 'Administrate', 'Vande', 'Kontable']);
    }

    function seMagasinierOswaAdmin(bizId) {
      return genWol(bizId, ['Propriyete', 'Administrate', 'Magasinier']);
    }

    match /biznis/{bizId} {

      // BOOTSTRAP: nenpot itilizate konekte ka kreye YON biznis (li vin premye pwopriyete a)
      allow create: if konekte();
      allow read: if manmBiznis(bizId);
      allow update, delete: if seAdministrate(bizId);

      // ---------- 1. STRUCTURE, GOUVERNANCE & ADMINISTRATION ----------

      match /itilizate/{userId} {
        // BOOTSTRAP: pwopriyete a ka kreye pwop pwofil li lokay, oswa yon admin envite lot moun
        allow create: if konekte() && (
          request.auth.uid == userId
          || seAdministrate(bizId)
        );
        allow read: if manmBiznis(bizId)
          && (request.auth.uid == userId || seAdministrate(bizId));
        allow update: if seAdministrate(bizId);
        allow delete: if false;
      }

      match /paramet/{docId} {
        allow read: if manmBiznis(bizId);
        allow write: if seAdministrate(bizId);
      }

      match /demandApwobasyon/{docId} {
        allow read: if manmBiznis(bizId);
        allow create: if manmBiznis(bizId);
        allow update: if genWol(bizId, ['Propriyete', 'Administrate', 'Direkte']);
        allow delete: if false;
      }

      match /succursale/{docId} {
        allow read: if manmBiznis(bizId);
        allow write: if seAdministrate(bizId);
      }

      match /depatman/{docId} {
        allow read: if manmBiznis(bizId);
        allow write: if seAdministrate(bizId);
      }

      match /pos/{docId} {
        allow read: if manmBiznis(bizId);
        allow write: if seAdministrate(bizId);
      }

      match /sessions/{docId} {
        // Itilizate ka li PWOP sesyon li; admin ka li tout sesyon yo
        allow read: if manmBiznis(bizId)
          && (resource.data.itilizateId == request.auth.uid || seAdministrate(bizId));
        allow create: if manmBiznis(bizId)
          && request.resource.data.itilizateId == request.auth.uid;
        allow update: if manmBiznis(bizId)
          && resource.data.itilizateId == request.auth.uid;
        allow delete: if false;
      }

      match /auditLog/{docId} {
        allow read: if seAdministrate(bizId);
        // Egzije itilizateId nan log la matche moun k ap ekri a (anpeche fosifikasyon)
        allow create: if manmBiznis(bizId)
          && request.resource.data.itilizateId == request.auth.uid;
        allow update, delete: if false;
      }

      match /notifikasyon/{docId} {
        // Chak itilizate li sèlman pwop notifikasyon li
        allow read: if manmBiznis(bizId)
          && resource.data.destinataireId == request.auth.uid;
        allow create: if manmBiznis(bizId);
        allow update: if manmBiznis(bizId)
          && resource.data.destinataireId == request.auth.uid;
        allow delete: if false;
      }

      // ---------- 3. VENTES, CRM & RELATION CLIENT ----------

      match /pwodwi/{pwodwiId} {
        allow read: if manmBiznis(bizId);
        // FIKS: ajoute seKontablOswaAdmin pou wòl Direkte ka mete ajou stock pandan yon Acha
        allow create, update: if seMagasinierOswaAdmin(bizId) || seVandeOswaAdmin(bizId) || seKontablOswaAdmin(bizId);
        allow delete: if false;
      }

      match /ajistman_stock/{docId} {
        allow read: if manmBiznis(bizId);
        allow create: if seMagasinierOswaAdmin(bizId);
        allow update, delete: if false;
      }

      match /stock_istorik/{docId} {
        allow read: if manmBiznis(bizId);
        allow create, update: if seMagasinierOswaAdmin(bizId) || seKontablOswaAdmin(bizId);
        allow delete: if false;
      }

      match /kliyan/{kliyanId} {
        allow read: if manmBiznis(bizId);
        allow create, update: if seVandeOswaAdmin(bizId);
        allow delete: if false;
      }

      match /peman_kliyan/{docId} {
        allow read: if manmBiznis(bizId);
        allow create: if seVandeOswaAdmin(bizId);
        allow update, delete: if false;
      }

      match /founise/{founiseId} {
        allow read: if manmBiznis(bizId);
        allow create, update: if seKontablOswaAdmin(bizId);
        allow delete: if false;
      }

      match /peman_founise/{docId} {
        allow read: if manmBiznis(bizId);
        allow create: if seKontablOswaAdmin(bizId);
        allow update, delete: if false;
      }

      match /lavant/{venteId} {
        allow read: if manmBiznis(bizId);
        allow create, update: if seVandeOswaAdmin(bizId);
        allow delete: if false;
      }

      match /acha/{achatId} {
        allow read: if manmBiznis(bizId);
        allow create, update: if seKontablOswaAdmin(bizId);
        allow delete: if false;
      }

      match /devis/{docId} {
        allow read: if manmBiznis(bizId);
        allow create, update: if seVandeOswaAdmin(bizId);
        allow delete: if false;
      }

      match /commande/{docId} {
        allow read: if manmBiznis(bizId);
        allow create, update: if seVandeOswaAdmin(bizId);
        allow delete: if false;
      }

      match /promotion/{docId} {
        allow read: if manmBiznis(bizId);
        allow create, update: if seVandeOswaAdmin(bizId);
        allow delete: if false;
      }

      match /fidelite/{docId} {
        allow read: if manmBiznis(bizId);
        allow write: if seVandeOswaAdmin(bizId);
      }

      match /kanpay_maketing/{docId} {
        allow read: if manmBiznis(bizId);
        allow create, update: if seVandeOswaAdmin(bizId);
        allow delete: if false;
      }

      match /sav/{docId} {
        allow read: if manmBiznis(bizId);
        allow create, update: if seVandeOswaAdmin(bizId);
        allow delete: if false;
      }

      match /avoir/{docId} {
        allow read: if manmBiznis(bizId);
        // Avoir se rezilta yon SAV — ID dokiman an dwe egal ticketSavId
        // (menm patwon ak bon_livrezon/venteId), pou anpeche 2 Avoir pou menm tikè
        allow create: if seVandeOswaAdmin(bizId)
          && request.resource.data.keys().hasAll(['ticketSavId', 'numeroAvoir', 'montantTTC'])
          && request.resource.data.ticketSavId is string
          && docId == request.resource.data.ticketSavId;
        allow update: if seVandeOswaAdmin(bizId);
        allow delete: if false;
      }

      match /objectif_vande/{docId} {
        allow read: if manmBiznis(bizId);
        allow write: if seAdministrate(bizId);
      }

      // ---------- LOGISTIQUE (Modil 5) ----------
      match /veyikil/{docId} {
        allow read: if manmBiznis(bizId);
        allow create, update: if seAdministrate(bizId);
        allow delete: if false;
      }

      match /chofe/{docId} {
        allow read: if manmBiznis(bizId);
        allow create, update: if seAdministrate(bizId);
        allow delete: if false;
      }

      match /bon_livrezon/{docId} {
        allow read: if manmBiznis(bizId);
        // BL egzije yon referans venteId valid — menm wòl ak lavant, paske BL se ekstansyon dirèk Vant lan
        allow create: if seVandeOswaAdmin(bizId)
          && request.resource.data.keys().hasAll(['venteId', 'nimewoBL', 'estati'])
          && request.resource.data.venteId is string
          && docId == request.resource.data.venteId;
        allow update: if seVandeOswaAdmin(bizId);
        allow delete: if false;
      }

      // ---------- MULTI-DÉPÔT (Modil 4.3) ----------
      match /depo/{docId} {
        allow read: if manmBiznis(bizId);
        allow create, update: if seMagasinierOswaAdmin(bizId);
        allow delete: if false;
      }

      match /stock/{docId} {
        allow read: if manmBiznis(bizId);

        allow create, update: if manmBiznis(bizId)
          && request.resource.data.keys().hasAll([
            'pwodwiId',
            'depoId',
            'kantiteStock'
          ])
          && request.resource.data.kantiteStock is number
          && request.resource.data.kantiteStock >= 0
          && docId == request.resource.data.pwodwiId + '__' + request.resource.data.depoId;

        allow delete: if false;
      }

      match /transferans_depo/{docId} {
        allow read: if manmBiznis(bizId);
        allow create: if manmBiznis(bizId);
        allow delete: if false;
      }

      // ---------- KÈS ----------

      match /sesyon_kes/{docId} {
        allow read: if manmBiznis(bizId);
        allow create, update: if seKontablOswaAdmin(bizId);
        allow delete: if false;
      }

      match /kes_mouvman/{docId} {
        allow read: if manmBiznis(bizId);
        allow create: if seKontablOswaAdmin(bizId);
        allow update, delete: if false;
      }

      // ---------- DEPANS ----------

      match /depans/{docId} {
        allow read: if manmBiznis(bizId);
        allow create: if seKontablOswaAdmin(bizId);
        allow update, delete: if false;
      }

      // ---------- KONTABILITE (kominan pou plizyè modil) ----------

      match /konte/{docId} {
        allow read: if manmBiznis(bizId);
        allow write: if seVandeOswaAdmin(bizId) || seKontablOswaAdmin(bizId);
      }

      match /jounal/{docId} {
        allow read: if manmBiznis(bizId);
        // Egzije chan debaz obligatwa pou diminye risk fo antre kontab manyèl
        allow create: if manmBiznis(bizId)
          && request.resource.data.keys().hasAll(['liy', 'dat', 'referans', 'sous'])
          && request.resource.data.liy is list
          && request.resource.data.liy.size() > 0;
        allow update, delete: if false;
      }

      match /plan_comptes/{docId} {
        allow read: if manmBiznis(bizId);
        allow write: if seKontablOswaAdmin(bizId);
      }

      // ---------- RESSOURCES HUMAINES (Modil 6) ----------

      function seRHOswaAdmin(bizId) {
        return genWol(bizId, ['Propriyete', 'Administrate', 'Direkte']);
      }

      match /anplwaye/{docId} {
        allow read: if manmBiznis(bizId)
          && (seRHOswaAdmin(bizId) || resource.data.itilizateId == request.auth.uid);
        allow create, update: if seRHOswaAdmin(bizId);
        allow delete: if false;
      }

      match /demann_konje/{docId} {
        allow read: if manmBiznis(bizId)
          && (seRHOswaAdmin(bizId) || resource.data.itilizateId == request.auth.uid);
        allow create: if manmBiznis(bizId)
          && request.resource.data.itilizateId == request.auth.uid
          && request.resource.data.estati == 'AnAtant';
        allow update: if seRHOswaAdmin(bizId);
        allow delete: if false;
      }

      match /prezans/{docId} {
        allow read: if manmBiznis(bizId)
          && (seRHOswaAdmin(bizId) || resource.data.itilizateId == request.auth.uid);
        allow create: if manmBiznis(bizId)
          && request.resource.data.itilizateId == request.auth.uid;
        allow update: if seRHOswaAdmin(bizId)
          || (manmBiznis(bizId) && resource.data.itilizateId == request.auth.uid);
        allow delete: if false;
      }

      match /pewol/{docId} {
        allow read: if manmBiznis(bizId)
          && (seRHOswaAdmin(bizId) || seKontablOswaAdmin(bizId)
              || resource.data.itilizateId == request.auth.uid);
        allow create, update: if seRHOswaAdmin(bizId) || seKontablOswaAdmin(bizId);
        allow delete: if false;
      }

      match /avans_sale/{docId} {
        allow read: if manmBiznis(bizId)
          && (seRHOswaAdmin(bizId) || seKontablOswaAdmin(bizId)
              || resource.data.itilizateId == request.auth.uid);
        // Anplwaye ka soumèt pwòp demann li (menm patwon ak demann_konje);
        // RH/Kontab ka tou kreye yon avans dirèkteman pou yon anplwaye
        allow create: if manmBiznis(bizId)
          && ((request.resource.data.itilizateId == request.auth.uid
               && request.resource.data.estati == 'AnAtant')
              || seRHOswaAdmin(bizId) || seKontablOswaAdmin(bizId));
        allow update: if seRHOswaAdmin(bizId) || seKontablOswaAdmin(bizId);
        allow delete: if false;
      }

      match /kandida/{docId} {
        // Done rekritman entèn — sèlman RH/Admin, pa gen aksè pou kandida a (li pa yon itilizatè app)
        allow read: if seRHOswaAdmin(bizId);
        allow create, update: if seRHOswaAdmin(bizId);
        allow delete: if false;
      }

      match /evalyasyon/{docId} {
        // Anplwaye ka wè pwòp evalyasyon li si li gen kont (itilizateId), RH/Admin wè tout
        allow read: if manmBiznis(bizId)
          && (seRHOswaAdmin(bizId) || resource.data.itilizateId == request.auth.uid);
        allow create, update: if seRHOswaAdmin(bizId);
        allow delete: if false;
      }

      match /fòmasyon/{docId} {
        allow read: if seRHOswaAdmin(bizId);
        allow create, update: if seRHOswaAdmin(bizId);
        allow delete: if false;
      }

      // ---------- ACTIFS & MAINTENANCE (Modil 7) ----------
      // NÒT: pa gen wòl 'Responsable Maintenance' nan sistèm wòl la (genWol()) —
      // seMagasinierOswaAdmin itilize kòm apwoksimasyon pou koleksyon operasyonèl
      // yo (plan/ticket antretyen), seKontablOswaAdmin pou koleksyon kontab yo
      // (immobilisations/amortisman), menm patrón ak plan_comptes/depans.
      // Konfime ak Emmanuel si sa dwe chanje pou yon vrè wòl dedye.

      match /immobilisations/{docId} {
        allow read: if manmBiznis(bizId);
        allow create, update: if seKontablOswaAdmin(bizId);
        allow delete: if false;
      }

      match /amortisman_istorik/{docId} {
        allow read: if manmBiznis(bizId);
        // Kreye sèlman pa AssetsService.egzekiteAmortisMwa() — jamè modifye/efase
        // (menm prensip ak jounal: yon ekriti istorik pa dwe chanje apre fèt).
        allow create: if seKontablOswaAdmin(bizId);
        allow update, delete: if false;
      }

      match /antretyen_plan/{docId} {
        allow read: if manmBiznis(bizId);
        allow create, update: if seMagasinierOswaAdmin(bizId);
        allow delete: if false;
      }

      match /antretyen_ticket/{docId} {
        allow read: if manmBiznis(bizId);
        allow create, update: if seMagasinierOswaAdmin(bizId);
        allow delete: if false;
      }

      // ---------- SAAS, LOCALISATION & PARAMÈTRES GLOBAUX (Modil 10) ----------

      match /tauxChange/{docId} {
        allow read: if manmBiznis(bizId);
        // Istorik pa dwe modifye — sèlman nouvo antre chak fwa
        allow create: if seKontablOswaAdmin(bizId);
        allow update, delete: if false;
      }

      match /abònman/{docId} {
        allow read: if manmBiznis(bizId);
        allow create, update: if seAdministrate(bizId);
        allow delete: if false;
      }

      match /lisans/{docId} {
        allow read: if manmBiznis(bizId);
        allow create, update: if seAdministrate(bizId);
        allow delete: if false;
      }

      match /integrasyon/{docId} {
        allow read: if manmBiznis(bizId);
        allow create, update: if seAdministrate(bizId);
        allow delete: if false;
      }

      // ---------- GED, ARCHIVAGE & GESTION DOCUMENTAIRE (Modil 8) ----------

      match /dokiman/{docId} {
        allow read: if manmBiznis(bizId);
        // Nenpòt manm biznis ka upload (Anplwaye gen dwa "Upload" selon Pèmisyon 8-Pèmisyon)
        allow create: if manmBiznis(bizId)
          && request.resource.data.keys().hasAll(['tit', 'kategori', 'storagePath', 'estati']);
        allow update: if manmBiznis(bizId);
        allow delete: if false;

        match /vèsyon/{vèsyonId} {
          allow read: if manmBiznis(bizId);
          allow create: if manmBiznis(bizId);
          allow update, delete: if false;
        }
      }
    }

    // ---------- PARAMÈT FISKAL GLOBAL (miltip-peyi, pa biznis-espesifik) ----------
    match /paramet_fiskal_global/{peyiCode} {
      allow read: if konekte();
      allow write: if false;   // Modifye sèlman via Firebase Console / Admin SDK
    }
  }
}
