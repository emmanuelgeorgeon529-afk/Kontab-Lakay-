rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- FONCTION DE SÉCURITÉ GLOBALE ---
    // Vérifie si l'utilisateur est authentifié et appartient à l'entreprise cible
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function belongsToCompany(companyId) {
      return isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/companies/$(companyId)/users).data;
    }

    function hasRole(companyId, roleName) {
      return belongsToCompany(companyId) && 
             get(/databases/$(database)/documents/companies/$(companyId)/users/$(request.auth.uid)).data.role == roleName;
    }

    // --- COLLECTION : ENTREPRISES (Multi-Biznis) ---
    // Seuls les Super Admins peuvent lire/créer une entreprise
    match /companies/{companyId} {
      allow read: if isAuthenticated() && (request.auth.token.superAdmin == true || belongsToCompany(companyId));
      allow write: if isAuthenticated() && request.auth.token.superAdmin == true;
      
      // --- COLLECTION : UTILISATEURS DE L'ENTREPRISE ---
      match /users/{userId} {
        allow read: if isAuthenticated() && belongsToCompany(companyId);
        allow write: if isAuthenticated() && (hasRole(companyId, 'Admin') || userId == request.auth.uid);
      }
      
      // --- COLLECTION : MODULES MÉTIER ---
      // Exemple : Module Finance (Seul Admin + Finance peuvent écrire)
      match /finance/{document} {
        allow read: if isAuthenticated() && belongsToCompany(companyId);
        allow write: if isAuthenticated() && (hasRole(companyId, 'Admin') || hasRole(companyId, 'Finance'));
      }

      // Exemple : Module RH (Seul Admin + RH peuvent écrire)
      match /rh/{document} {
        allow read: if isAuthenticated() && belongsToCompany(companyId);
        allow write: if isAuthenticated() && (hasRole(companyId, 'Admin') || hasRole(companyId, 'RH'));
      }

      // Exemple : Module Ventes (Tout le monde peut lire, Admin+Vente peut écrire)
      match /sales/{document} {
        allow read: if isAuthenticated() && belongsToCompany(companyId);
        allow write: if isAuthenticated() && (hasRole(companyId, 'Admin') || hasRole(companyId, 'Sales'));
      }

      // RÈGLE GÉNÉRALE DE SÉCURITÉ (Fallback) : 
      // Si aucun module spécifique n'est défini, seul l'Admin peut écrire.
      match /{document=**} {
        allow read: if isAuthenticated() && belongsToCompany(companyId);
        allow write: if isAuthenticated() && hasRole(companyId, 'Admin');
      }
    }
  }
}
