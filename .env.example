# ============================================
# KONTAB LAKAY - Environment Variables Template
# ============================================
# Kopye fichye sa a rele li ".env" epi ranpli valè yo si ou bezwen.
# NEPA janm push ".env" reyèl la sou GitHub - li dwe nan .gitignore.
# Valè sa yo dwe kole nan js/core/config.js pou window.db / window.auth

# --- Firebase Configuration ---
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# --- App Info ---
APP_NAME=Kontab Lakay
APP_ENV=production
DEFAULT_LOCALE=ht
DEFAULT_CURRENCY=HTG

# --- Deploiman (GitHub Pages) ---
GITHUB_REPO_URL=
DEPLOY_BRANCH=main

# --- Entegrasyon (rezève pou pita, pa aktif kounye a) ---
# WHATSAPP_BUSINESS_TOKEN=
# ANTHROPIC_API_KEY=
# GOOGLE_APPS_SCRIPT_URL=
