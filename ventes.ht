<!-- views/ventes.html -->
<section id="ventes" class="view-section">
    <!-- Header & Actions -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 8px;">
        <h2 style="font-size: 22px; font-weight: 600;">Ventes & CRM</h2>
        <div style="display: flex; gap: 8px;">
            <button style="background: var(--primary); color: white; border: none; padding: 8px 16px; border-radius: 8px; font-weight: 600; cursor: pointer;">➕ Nouvo Vant</button>
            <button style="background: white; border: 1px solid #E2E8F0; padding: 8px 16px; border-radius: 8px; font-weight: 600; cursor: pointer;">📊 Rapò</button>
        </div>
    </div>

    <!-- 3.1 Dashboard Commercial (KPI) -->
    <div class="kpi-grid" style="grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));">
        <div class="kpi-card"><div class="label">🛒 Vant Jodi a</div><div class="value">125 000 HTG</div><div class="change up">↑ 15%</div></div>
        <div class="kpi-card"><div class="label">📈 Vant Mwa a</div><div class="value">3 450 000 HTG</div><div class="change up">↑ 8,5%</div></div>
        <div class="kpi-card"><div class="label">👥 Nouvo Kliyan</div><div class="value">18</div><div class="change up">↑ 5</div></div>
        <div class="kpi-card"><div class="label">💰 Chif Afè (CA)</div><div class="value">8 200 000 HTG</div><div class="change up">↑ 12%</div></div>
        <div class="kpi-card"><div class="label">📋 Devis An Atant</div><div class="value" style="color: var(--primary);">24</div><div class="change up">↑ 3</div></div>
        <div class="kpi-card"><div class="label">🔴 Dèt Kliyan</div><div class="value" style="color: var(--danger);">850 000 HTG</div><div class="change down">↑ 6%</div></div>
        <div class="kpi-card"><div class="label">⭐ Top Kliyan</div><div class="value">SuperStore</div></div>
        <div class="kpi-card"><div class="label">🏆 Top Vandè</div><div class="value">Marie C.</div><div class="change up">↑ 22k</div></div>
    </div>

    <!-- 3.1 Graf : Vant pa mwa & pa pwodwi -->
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 24px;">
        <div class="chart-section">
            <div class="chart-header"><h4 style="font-weight:600;">📊 Vant pa Mwa</h4></div>
            <div class="chart-container"><canvas id="salesChartMonthly"></canvas></div>
        </div>
        <div class="chart-section">
            <div class="chart-header"><h4 style="font-weight:600;">📈 Vant pa Pwodwi</h4></div>
            <div class="chart-container"><canvas id="salesChartProduct"></canvas></div>
        </div>
    </div>

    <!-- 3.2 Gestion Kliyan (CRM) & 3.8 Commandes Clients -->
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 24px;">
        <div class="chart-section">
            <div class="chart-header"><h4 style="font-weight:600;">👥 Top Kliyan (CRM)</h4><span style="font-size:12px; color:var(--text-muted);">+ Tout kliyan</span></div>
            <table class="fin-table" style="width:100%;">
                <thead><tr><th>ID</th><th>Non</th><th>Kategori</th></tr></thead>
                <tbody>
                    <tr><td>CL-001</td><td>SuperStore</td><td>Grande Entreprise</td></tr>
                    <tr><td>CL-002</td><td>Jean Marché</td><td>PME</td></tr>
                    <tr><td>CL-003</td><td>Marie Mode</td><td>Particulier</td></tr>
                    <tr><td>CL-004</td><td>InterMercat</td><td>VIP</td></tr>
                </tbody>
            </table>
        </div>

        <div class="chart-section">
            <div class="chart-header"><h4 style="font-weight:600;">🔄 Estati Komand yo</h4></div>
            <div style="display:flex; flex-wrap:wrap; gap:6px; justify-content:center; padding:8px;">
                <span style="background:#FEF3C7; color:#B45309; padding:4px 10px; border-radius:12px; font-size:12px;">🟡 Brouillon</span>
                <span style="background:#DBEAFE; color:#1D4ED8; padding:4px 10px; border-radius:12px; font-size:12px;">🔵 Confirmée</span>
                <span style="background:#FED7AA; color:#9A3412; padding:4px 10px; border-radius:12px; font-size:12px;">🟠 An Preparasyon</span>
                <span style="background:#F3E8FF; color:#6D28D9; padding:4px 10px; border-radius:12px; font-size:12px;">🚚 Expédiée</span>
                <span style="background:#D1FAE5; color:#047857; padding:4px 10px; border-radius:12px; font-size:12px;">🟢 Livrée</span>
                <span style="background:#FEE2E2; color:#B91C1C; padding:4px 10px; border-radius:12px; font-size:12px;">🔴 Annulée</span>
            </div>
        </div>
    </div>

    <!-- 3.4 POS, 3.5 Panier, 3.6 Facturation & 3.7 Devis -->
    <div class="chart-section">
        <div class="chart-header"><h4 style="font-weight:600;">🛒 POS & Panier Intelligent</h4><span style="font-size:12px; color:var(--text-muted);">Scan Barcode</span></div>
        <div style="display:grid; grid-template-columns: 1fr 1fr; gap:16px;">
            <div>
                <div style="border:1px solid #E2E8F0; border-radius:8px; padding:8px; background:#F8FAFC;">
                    <span style="font-size:12px; color:var(--text-muted);">Prodwi</span>
                    <div style="font-weight:500;">Pwodwi A (SKU: 001)</div>
                    <div style="display:flex; justify-content:space-between; margin-top:4px;"><span>Qty: 2</span><span>Total: 2 000 HTG</span></div>
                </div>
                <div style="border:1px solid #E2E8F0; border-radius:8px; padding:8px; margin-top:8px; background:#F8FAFC;">
                    <span style="font-size:12px; color:var(--text-muted);">Pwodwi</span>
                    <div style="font-weight:500;">Pwodwi B (SKU: 002)</div>
                    <div style="display:flex; justify-content:space-between; margin-top:4px;"><span>Qty: 1</span><span>Total: 1 500 HTG</span></div>
                </div>
                <div style="margin-top:8px; text-align:right; font-weight:700; border-top:2px solid var(--primary); padding-top:8px;">Total Panier: 3 500 HTG</div>
            </div>
            <div style="border-left:1px solid #E2E8F0; padding-left:16px;">
                <h5 style="font-weight:600; margin-bottom:8px;">⚡ Peman & Faktirasyon</h5>
                <div style="background:#D1FAE5; padding:6px; border-radius:4px; font-size:12px; margin-bottom:4px;">💳 Peman: Espès / Kredi</div>
                <div style="border:1px solid #E2E8F0; padding:6px; border-radius:4px; font-size:12px;">📄 Faktirasyon: N° FACT-002024</div>
                <div style="display:flex; gap:4px; margin-top:8px;">
                    <button style="background:var(--primary); color:white; border:none; padding:4px 10px; border-radius:4px; font-size:12px;">PDF</button>
                    <button style="background:#F1F5F9; border:1px solid #E2E8F0; padding:4px 10px; border-radius:4px; font-size:12px;">Email</button>
                </div>
                <div style="margin-top:12px; background:#F1F5F9; padding:8px; border-radius:8px; font-size:13px;">
                    🔄 Devis: <strong>DEV-004</strong> → Konvèti an Faktì
                </div>
            </div>
        </div>
    </div>

    <!-- 3.11 Catalogue Produits & 3.12 Gestion Prix -->
    <div class="chart-section">
        <div class="chart-header"><h4 style="font-weight:600;">📦 Catalogue Produits</h4><span style="font-size:12px; color:var(--text-muted);">SKU | Barcode</span></div>
        <table class="fin-table" style="width:100%;">
            <thead><tr><th>SKU</th><th>Pwodwi</th><th>Pri Detay</th><th>Pri Gros</th><th>Stock</th></tr></thead>
            <tbody>
                <tr><td>SKU-001</td><td>Kafe Bon Gou</td><td>200 HTG</td><td>160 HTG</td><td style="color:var(--secondary);">58</td></tr>
                <tr><td>SKU-002</td><td>Ri Asye</td><td>1 500 HTG</td><td>1 200 HTG</td><td style="color:var(--danger);">2</td></tr>
                <tr><td>SKU-003</td><td>Telefòn Smart</td><td>25 000 HTG</td><td>22 000 HTG</td><td style="color:var(--secondary);">14</td></tr>
            </tbody>
        </table>
    </div>

    <!-- 3.9 Credit, 3.10 Recouvrement, 3.13 Promos, 3.14 Fidelite -->
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 24px;">
        <div class="chart-section">
            <div class="chart-header"><h4 style="font-weight:600;">🧾 Kredi & Recouvrement</h4></div>
            <div style="display:flex; justify-content:space-between; border-bottom:1px solid #E2E8F0; padding:4px 0;"><span>Kliyan: SuperStore</span><span style="color:var(--danger);">Dèt: 120k</span></div>
            <div style="display:flex; justify-content:space-between; border-bottom:1px solid #E2E8F0; padding:4px 0;"><span>Limit Kredi: 250k</span><span style="color:var(--secondary);">📍 Disponib</span></div>
            <div style="display:flex; gap:8px; flex-wrap:wrap; margin-top:8px;">
                <button style="background:#F1F5F9; border:1px solid #E2E8F0; padding:4px 8px; border-radius:4px; font-size:12px;">📞 Rele</button>
                <button style="background:#F1F5F9; border:1px solid #E2E8F0; padding:4px 8px; border-radius:4px; font-size:12px;">📧 Email</button>
                <button style="background:var(--secondary); color:white; border:none; padding:4px 8px; border-radius:4px; font-size:12px;">📱 WhatsApp</button>
            </div>
        </div>

        <div class="chart-section">
            <div class="chart-header"><h4 style="font-weight:600;">🏷️ Promos & Fidélité</h4></div>
            <div style="display:flex; flex-wrap:wrap; gap:4px; margin-bottom:8px;">
                <span style="background:#FEF3C7; padding:4px 8px; border-radius:4px; font-size:12px;">🏷️ Rabè 10%</span>
                <span style="background:#D1FAE5; padding:4px 8px; border-radius:4px; font-size:12px;">🎁 Buy 1 Get 1</span>
                <span style="background:#DBEAFE; padding:4px 8px; border-radius:4px; font-size:12px;">💵 Rabè 500 HTG</span>
            </div>
            <div><strong>Carte Fidélité:</strong> Jean Marché (Pwen: 450) 🎁 Cashback: 2 250 HTG</div>
        </div>
    </div>

    <!-- 3.15 Marketing, 3.16 SAV, 3.17 Retours -->
    <div class="chart-section">
        <div class="chart-header"><h4 style="font-weight:600;">📣 Sèvis Kliyan & Marketing</h4></div>
        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12px;">
            <div>
                <h5 style="font-size:13px; color:var(--text-muted);">Kanpagn Maketing</h5>
                <div style="display:flex; gap:4px;">
                    <span style="background:#E2E8F0; padding:2px 6px; border-radius:4px;">📧</span>
                    <span style="background:#E2E8F0; padding:2px 6px; border-radius:4px;">📱 SMS</span>
                    <span style="background:#E2E8F0; padding:2px 6px; border-radius:4px;">💬 WhatsApp</span>
                </div>
            </div>
            <div>
                <h5 style="font-size:13px; color:var(--text-muted);">SAV (Apè Vant)</h5>
                <div style="border-left: 2px solid var(--primary); padding-left:6px;">
                    <div>🛠️ Reklamasyon: 3</div>
                    <div>🔄 Retou: 1 an kou</div>
                </div>
            </div>
            <div>
                <h5 style="font-size:13px; color:var(--text-muted);">Flè Retou</h5>
                <div style="border:1px dashed #E2E8F0; padding:4px; border-radius:4px; font-size:12px; background:#F8FAFC;">
                    Retour → Inspection → Remboursement
                </div>
            </div>
        </div>
    </div>

    <!-- 3.18 Analyse & 3.19 Objectifs -->
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 24px;">
        <div class="chart-section">
            <div class="chart-header"><h4 style="font-weight:600;">📊 Analiz Vant</h4></div>
            <div style="display:flex; flex-direction:column; gap:4px; font-size:13px;">
                <div><span>Kategori Top:</span> <span style="font-weight:500;">Elektronik</span></div>
                <div><span>Top Kliyan:</span> <span style="font-weight:500;">SuperStore</span></div>
                <div><span>Top Rejyon:</span> <span style="font-weight:500;">Pòtoprens</span></div>
            </div>
        </div>

        <div class="chart-section">
            <div class="chart-header"><h4 style="font-weight:600;">🎯 Objektif Komèsyal</h4></div>
            <div><span>Vandè A (Marie C.)</span><span style="float:right;">420k / 500k</span></div>
            <div style="width:100%; height:6px; background:#E2E8F0; border-radius:4px; margin:4px 0;">
                <div style="width:84%; height:100%; background:var(--primary); border-radius:4px;"></div>
            </div>
            <div style="margin-top:6px; font-weight:500; color:var(--secondary);">Atèny: 84%</div>
        </div>
    </div>

    <!-- 3.20 Dashboard Directeur Commercial -->
    <div class="kpi-grid" style="grid-template-columns: 1fr;">
        <div class="kpi-card" style="background: var(--primary); color: white; border: none;">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <div style="font-size: 13px; opacity: 0.8;">📊 Dashboard Directeur Commercial</div>
                    <div style="font-size: 20px; font-weight: 700; margin: 8px 0;">Chif Afè: 8.2M HTG</div>
                    <div style="font-size: 13px;">Croissance: +12% | Top Pwodwi: Kafe</div>
                </div>
                <div style="font-size: 40px;">🚀</div>
            </div>
        </div>
    </div>
  </section>
